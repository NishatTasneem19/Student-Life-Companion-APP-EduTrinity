<!-- res/drawable/button_gradient.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <stroke
        android:width="5dp"
        android:color="#000080" />
    <gradient
        android:angle="90"
        android:startColor="#ADF7F2"
        android:endColor="#15aaff"
        android:type="linear" />
    <corners android:radius="20dp"/>  <!-- rounded corners -->
</shape>
