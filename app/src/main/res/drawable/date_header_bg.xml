<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color -->
    <solid android:color="#FFE4EC" />

    <!-- Border color & width -->
    <stroke
        android:width="1dp"
        android:color="#F48FB1" /> <!-- soft pink border -->



    <!-- Optional inner padding -->
    <padding
        android:left="8dp"
        android:top="4dp"
        android:right="8dp"
        android:bottom="4dp" />
</shape>
