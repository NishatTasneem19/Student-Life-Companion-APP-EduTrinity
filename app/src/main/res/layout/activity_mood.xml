<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/moodwallpaper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/moodQuestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today, I feel..."
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:background="@android:color/transparent"/>

        <!-- First row of moods -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btn1"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="85dp"
                android:text="Happy"
                android:textStyle="bold"
                android:textSize="10sp"
                android:background="@android:color/transparent"
                android:drawableTop="@drawable/happy"/>

            <Button
                android:id="@+id/btn2"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="85dp"
                android:text="Sad"
                android:textStyle="bold"
                android:textSize="10sp"
                android:background="@android:color/transparent"
                android:drawableTop="@drawable/sad"/>

            <Button
                android:id="@+id/btn3"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="85dp"
                android:text="Angry"
                android:textStyle="bold"
                android:textSize="10sp"
                android:background="@android:color/transparent"
                android:drawableTop="@drawable/angry"/>

            <Button
                android:id="@+id/btn4"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="85dp"
                android:text="Anxious"
                android:textStyle="bold"
                android:textSize="10sp"
                android:background="@android:color/transparent"
                android:drawableTop="@drawable/anxious"/>

            <Button
                android:id="@+id/btn5"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="85dp"
                android:text="Calm"
                android:textStyle="bold"
                android:textSize="10sp"
                android:background="@android:color/transparent"
                android:drawableTop="@drawable/calm"/>
        </LinearLayout>

        <!-- Second row of moods -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btn6"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="85dp"
                android:text="Loved"
                android:textStyle="bold"
                android:textSize="10sp"
                android:background="@android:color/transparent"
                android:drawableTop="@drawable/love"/>

            <Button
                android:id="@+id/btn7"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="85dp"
                android:text="Depressed"
                android:textStyle="bold"
                android:textSize="10sp"
                android:background="@android:color/transparent"
                android:drawableTop="@drawable/depressed"/>

            <Button
                android:id="@+id/btn8"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="85dp"
                android:text="Sick"
                android:textStyle="bold"
                android:textSize="10sp"
                android:background="@android:color/transparent"
                android:drawableTop="@drawable/sick"/>

            <Button
                android:id="@+id/btn9"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="85dp"
                android:text="Crying"
                android:textStyle="bold"
                android:textSize="10sp"
                android:background="@android:color/transparent"
                android:drawableTop="@drawable/cry"/>

            <Button
                android:id="@+id/btn10"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="85dp"
                android:text="Excited"
                android:textStyle="bold"
                android:textSize="10sp"
                android:background="@android:color/transparent"
                android:drawableTop="@drawable/excited"/>
        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/des"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A glimpse into my day:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="left"
            android:layout_marginTop="20dp"/>

        <EditText
            android:id="@+id/etd"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@drawable/custom_edittext"
            android:gravity="top|start"
            android:hint="(Max 50 words)"
            android:inputType="textMultiLine"
            android:maxLength="1500"
            android:scrollbars="vertical"
            android:padding="6dp"
            android:textColor="#000000"
            android:textSize="16sp" />

        <!-- Vertical buttons at bottom -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp">

            <Button
                android:layout_margin="5dp"
                android:id="@+id/saveBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save"
                android:background="@drawable/but3"
                />

            <Button
                android:layout_margin="5dp"
                android:layout_width="wrap_content"
                android:id="@+id/viewHistoryBtn"
                android:layout_height="wrap_content"
                android:text="History"
                android:background="@drawable/but3"
                />

            <Button
                android:layout_margin="5dp"
                android:id="@+id/viewInsightsBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Insights"
                android:background="@drawable/but3"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
