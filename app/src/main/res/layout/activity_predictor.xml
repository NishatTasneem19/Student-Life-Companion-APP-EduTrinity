<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/tech_bg">

    <!-- Top Row Buttons with icons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp"
        android:layout_marginTop="140dp">





    </LinearLayout>

    <!-- Instruction -->
    <TextView
        android:id="@+id/tvInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose a semester (max 17):"
        android:textSize="16sp"
        android:textColor="#333333"
        android:layout_marginBottom="12dp"
        android:fontFamily="@font/roboto_medium" />

    <!-- Semester input -->
    <EditText
        android:id="@+id/etSemester"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Enter semester number"
        android:inputType="number"
        android:layout_marginBottom="16dp"
        android:padding="12dp"
        android:background="@drawable/edittext_rounded"
        android:textColor="#000000"
        android:textSize="16sp"
        android:fontFamily="@font/roboto_regular" />

    <!-- Predict Button -->
    <Button
        android:id="@+id/btnPredict"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Predict GPA"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/btn_primary_rounded"
        android:fontFamily="@font/roboto_medium" />

    <!-- Result -->
    <TextView
        android:id="@+id/tvPrediction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Prediction will appear here"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#D3BDBD"
        android:gravity="center"
        android:padding="16dp"
        android:background="@drawable/result_box"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/roboto_medium" />

</LinearLayout>
