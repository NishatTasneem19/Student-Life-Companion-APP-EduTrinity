<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tasbih_start"
    android:orientation="vertical"
    android:gravity="center"
    tools:context=".Tasbeehstart">

<LinearLayout
android:id="@+id/main"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical"
android:gravity="center"
    android:layout_margin="10dp">

<ImageView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_gravity="center"
android:layout_marginTop="20dp" />

<TextView
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:textStyle="bold"
android:textSize="27sp"
android:gravity="center"
android:layout_marginBottom="30dp" />

<Button
android:id="@+id/b1"
android:layout_width="250dp"
android:layout_height="80dp"
android:background="@drawable/button1"
android:drawableEnd="@drawable/tasbeeh"
android:text="Tasbeeh Counter >"
    android:padding="25dp"
android:textColor="@color/black"
android:textSize="13sp" />

<Button
android:id="@+id/b2"
android:layout_width="250dp"
android:layout_height="80dp"
android:layout_margin="20dp"
android:background="@drawable/button2"
android:drawableEnd="@drawable/man"
android:text="Ready Dhikr >"
    android:padding="25dp"
android:textColor="@color/black"
android:textSize="13sp" />

<Button
android:id="@+id/b3"
android:layout_width="250dp"
android:layout_height="80dp"
    android:background="@drawable/button1"
    android:padding="25dp"
android:drawableEnd="@drawable/prayer"
android:text="Dua by editors >"
android:textColor="@color/black"
android:textSize="13sp" />
</LinearLayout>

</LinearLayout>
