<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeActivity"

    android:fitsSystemWindows="true">

    <!-- 🌟 Main Content -->
    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FFF8F0"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- 🖼️ Top Section with Image and Menu -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6"
        android:clipToPadding="false"
        android:clipChildren="false">

        <ImageView
            android:id="@+id/imageExample"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/menu1"
            android:alpha="0.85"
            android:contentDescription="Example Image"
            android:background="@color/black" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="top|end"
            android:layout_margin="20dp"

            android:src="@drawable/menumain"
            android:background="#ffffff"
            android:contentDescription="Menu Button"

            android:elevation="6dp" />
    </FrameLayout>

    <!-- 🟨 Bottom Section with Color Boxes as Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="9"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        android:weightSum="2"
        android:padding="8dp">

        <!-- Left Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:layout_marginEnd="12dp">

            <Button
                android:id="@+id/btnTopLeft"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="16dp"
            android:text="Academic Tools"
            android:textColor="#BF360C"
            android:textStyle="bold"
            android:gravity="center"
            android:textAllCaps="false"
            android:elevation="4dp"
            android:stateListAnimator="@null"
          android:background="#ffffff" />

            <Button
                android:id="@+id/btnBottomLeft"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="16dp"
                android:text="Personal Management"

                android:textColor="#01579B"
                android:textStyle="bold"
                android:gravity="center"
                android:textAllCaps="false"
                android:elevation="4dp"
                android:stateListAnimator="@null"
                android:background="#ffffff" />
        </LinearLayout>

        <!-- Right Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:layout_marginStart="12dp">

            <Button
                android:id="@+id/btnTopRight"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="16dp"
                android:background="#ffffff"
            android:text="Productivity and Focus"
            android:textColor="#1B5E20"
            android:textStyle="bold"
            android:gravity="center"
            android:textAllCaps="false"
            android:elevation="4dp"
            android:stateListAnimator="@null"
       />

            <Button
                android:id="@+id/btnBottomRight"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="16dp"
                android:text="Spiritual Corner"
                android:textColor="#E65100"
                android:textStyle="bold"
                android:gravity="center"
                android:textAllCaps="false"
                android:elevation="4dp"
                android:stateListAnimator="@null"
                android:background="#ffffff" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

    <!-- 🌟 Right Sidebar (Drawer) -->
<LinearLayout
android:id="@+id/sidebarLayout"
android:layout_width="300dp"
android:layout_height="match_parent"
android:orientation="vertical"
android:layout_gravity="end"
android:background="@android:color/white"
android:elevation="16dp"
android:padding="24dp">

<!-- 👤 Profile Info -->
<TextView
    android:id="@+id/tvName"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Name"
    android:textStyle="bold"
    android:textSize="22sp"
    android:textColor="#212121"
    android:layout_marginBottom="4dp" />

<TextView
    android:id="@+id/tvDepartment"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Department"
    android:textSize="16sp"
    android:textColor="#616161"
    android:layout_marginBottom="2dp" />

<TextView
    android:id="@+id/tvSemester"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Semester"
    android:textSize="16sp"
    android:textColor="#616161"
    android:layout_marginBottom="16dp" />

<View
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:background="#E0E0E0"
    android:layout_marginBottom="16dp" />

<!-- ⚙️ Menu Options -->
<TextView
    android:id="@+id/btnToggleTheme"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Toggle Theme"
    android:textSize="18sp"
    android:textColor="#424242"
    android:paddingVertical="14dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="12dp"
    android:paddingEnd="12dp" />

<TextView
    android:id="@+id/btnAbout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="About"
    android:textSize="18sp"
    android:textColor="#424242"
    android:paddingVertical="14dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:layout_marginTop="8dp" />

<TextView
    android:id="@+id/btnFeedback"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Feedback"
    android:textSize="18sp"
    android:textColor="#424242"
    android:paddingVertical="14dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:layout_marginTop="8dp" />
</LinearLayout>
    </androidx.drawerlayout.widget.DrawerLayout>
