<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/midnight2"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Auto Sleep Tracking"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <ToggleButton
        android:id="@+id/autoSleepToggle"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:textOff="START"
        android:textOn="STOP"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#808080"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/autoTimeDisplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: Ready"
        android:textColor="#00FFFF"
        android:textSize="18sp"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/bedtimeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bedtime: --:--"
        android:textColor="#FFFFFF"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/wakeupText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wakeup: --:--"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:layout_marginBottom="30dp" />

    <Button
        android:id="@+id/resetBtnAuto"
        android:layout_width="300dp"
        android:layout_height="55dp"
        android:text="🔄 Reset Tracking"
        android:backgroundTint="#EF4444"
        android:textColor="#FFFFFF"
        android:layout_marginTop="10dp" />
    <Button
        android:id="@+id/saveBtnAuto"
        android:layout_width="300dp"
        android:layout_height="55dp"
        android:textColor="#FFFFFF"
        android:text="💾 Save Sleep Data"
        android:backgroundTint="#7C3AED"
        android:layout_marginTop="10dp" />

    <Button
        android:id="@+id/viewBtnAuto"
        android:layout_width="300dp"
        android:layout_height="55dp"
        android:textColor="#FFFFFF"
        android:text="📊 View Last Record"
        android:backgroundTint="#4F46E5"
        android:layout_marginTop="10dp" />

    <Button
        android:id="@+id/historyBtnAuto"
        android:layout_width="300dp"
        android:layout_height="55dp"
        android:textColor="#FFFFFF"
        android:text="📖 View Sleep History"
        android:backgroundTint="#10B981"
        android:layout_marginTop="10dp" />

</LinearLayout>