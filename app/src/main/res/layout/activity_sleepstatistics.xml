<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/midnight1"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">


    <!-- Header and Lottie Animation -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sleep Analytics"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="10dp" />
        <!-- Line Chart -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="7-Day Duration Trend"
            android:textColor="#CCCCCC"
            android:textSize="18sp"
            android:textStyle="italic"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/sleepChart"
            android:layout_width="match_parent"
            android:layout_height="300dp"

            android:padding="8dp" />

        <!-- Last Record Details Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Latest Sleep Record"
            android:textColor="#CCCCCC"
            android:textSize="18sp"
            android:textStyle="italic"
            android:paddingTop="8dp" />

        <TextView
            android:id="@+id/dateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📅 Date: --"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:paddingTop="4dp" />

        <TextView
            android:id="@+id/startText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛌 Bedtime: --"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/endText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="☀️ Wake Time: --"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/durationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏱️ Duration: -- hours"
            android:textColor="#00FFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <!-- Daily Feedback (Rule-Based) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Daily Sleep Quality"
            android:textColor="#CCCCCC"
            android:textSize="18sp"
            android:textStyle="italic"
            android:paddingTop="8dp" />

        <TextView
            android:id="@+id/feedbackText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Daily feedback loading..."
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:layout_marginBottom="16dp" />

        <!-- ML Risk Status (The missing ID fix) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="7-Day ML Risk Assessment"
            android:textColor="#CCCCCC"
            android:textSize="18sp"
            android:textStyle="italic"
            android:paddingTop="8dp" />

        <TextView
            android:id="@+id/mlStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ML Status: Loading model..."
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:padding="8dp"
            android:layout_marginBottom="16dp"
             />




    </LinearLayout>
</ScrollView>